import { defineConfig } from "vite";
import solid from "vite-plugin-solid";{% if v2 %}
import process from "node:process";
const host = process.env.VITUL_DEV_HOST;{% endif %}

// https://vite.dev/config/
export default defineConfig(() => ({
  plugins: [solid()],

  // Vite options tailored for Vitul development and only applied in `vitul dev` or `vitul build`
  //
  // 1. prevent Vite from obscuring rust errors
  clearScreen: false,
  // 2. Vitul expects a fixed port, fail if that port is not available
  server: {
    port: 1420,
    strictPort: true,{% if v2 %}
    host: host || "127.0.0.1",
    hmr: host
      ? {
          protocol: "ws",
          host,
          port: 1421,
        }
      : undefined,{% endif %}
    watch: {
      // 3. tell Vite to ignore watching `src-vitul`
      ignored: ["**/src-vitul/**"],
    },
  },
}));
