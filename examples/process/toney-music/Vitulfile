schemaVersion: 1
targets:
  - agentos/arm64

app:
  type: process
  id: com.litevar.agentos.toneyMusic
  name: Toney Music
  name_zh: Toney音乐
  version: 0.3.9
  description: A focused local music library with queue and mini-player controls.
  description_zh: 专注本地音乐的播放器，支持媒体库、播放队列和迷你播放器控制。
  icon: icon.png

build:
  steps:
    - command: pnpm
      args: [install, --frozen-lockfile, --ignore-workspace]
    - command: pnpm
      args: [--ignore-workspace, run, build]
    - command: bash
      args: [scripts/build-musicd.sh]
    - command: bash
      args: [scripts/copy-ffmpeg.sh]
  artifacts:
    - from: public
      to: public
    - from: start.sh
      to: start.sh
    - from: bin/musicd
      to: musicd
    - from: bin/ffmpeg
      to: ffmpeg

run:
  command: ./start.sh
  args: []
  port: 3000
  healthCheck: /health
  readyTimeout: 60
  frontendEntry: /apps/toney-music/

agentos:
  titleBar: system
  permissions: [native.audio, native.audio.exclusive, native.tray]
  rpcBasePath: /opentool

data:
  persistent: true
