{
  "id": "toney-music",
  "name": "Toney Music",
  "name_zh": "Toney音乐",
  "version": "0.3.10",
  "description": "A focused local music library with queue and mini-player controls.",
  "description_zh": "专注本地音乐的播放器，支持媒体库、播放队列和迷你播放器控制。",
  "run": {
    "type": "process",
    "entry": "start.sh",
    "port": 0,
    "healthCheck": "/health",
    "readyTimeout": 30,
    "autoStart": true,
    "env": {}
  },
  "open": {
    "mode": "workspace",
    "url": "${baseurl}/apps/toney-music/index.html"
  }
}
