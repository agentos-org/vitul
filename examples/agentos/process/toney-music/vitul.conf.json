{
  "schemaVersion": 2,
  "productName": "Toney Music",
  "identifier": "com.litevar.agentos.toneyMusic",
  "version": "0.3.10",
  "bundle": {
    "icon": ["icon.png"]
  },
  "agentos": {
    "type": "process",
    "description": "A focused local music library with queue and mini-player controls.",
    "descriptionZh": "专注本地音乐的播放器，支持媒体库、播放队列和迷你播放器控制。",
    "nameZh": "Toney音乐",
    "targets": ["agentos/arm64"],
    "build": {
      "steps": [
        { "command": "pnpm", "args": ["install", "--frozen-lockfile", "--ignore-workspace"] },
        { "command": "pnpm", "args": ["--ignore-workspace", "run", "build"] },
        { "command": "bash", "args": ["scripts/build-musicd.sh"] },
        { "command": "bash", "args": ["scripts/copy-ffmpeg.sh"] }
      ],
      "artifacts": [
        { "from": "public", "to": "public" },
        { "from": "start.sh", "to": "start.sh" },
        { "from": "bin/musicd", "to": "musicd" },
        { "from": "bin/ffmpeg", "to": "ffmpeg" }
      ]
    },
    "run": {
      "command": "./start.sh",
      "args": [],
      "port": 3000,
      "healthCheck": "/health",
      "readyTimeout": 60,
      "frontendEntry": "/apps/toney-music/index.html"
    },
    "open": {
      "mode": "workspace",
      "titleBar": "system"
    },
    "permissions": ["native.audio", "native.audio.exclusive", "native.tray"],
    "rpc": {
      "basePath": "/opentool",
      "discovery": "runtime"
    },
    "data": { "persistent": true }
  }
}
