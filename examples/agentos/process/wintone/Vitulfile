schemaVersion: 1
targets:
  - agentos/arm64
  - agentos/x64

app:
  type: process
  id: com.agentos.wintone
  name: WinTone
  name_zh: 温易通
  version: 0.1.0
  description: Manage Windows application installers and installations on AgentOS.
  description_zh: 在 AgentOS 上管理 Windows 应用安装包与已安装应用。
  icon: icon.png

build:
  steps:
    - command: bash
      args: [scripts/build-server.sh]
  artifacts:
    - from: public
      to: public
    - from: start.sh
      to: start.sh
    - from: bin/wintone-server
      to: wintone-server
    - from: icon.png
      to: icon.png

run:
  command: ./start.sh
  args: []
  port: 3000
  healthCheck: /health
  readyTimeout: 60
  frontendEntry: /apps/wintone/
  env:
    FEX_ROOTFS: ""
    WINEDEBUG: ""
    WINEPREFIX: ""

agentos:
  openMode: workspace
  titleBar: system
  permissions: [native.file-dialogs, native.external-wayland, native.external-wayland.network]
  rpcBasePath: /opentool
  rpcDiscovery: runtime

data:
  persistent: true
