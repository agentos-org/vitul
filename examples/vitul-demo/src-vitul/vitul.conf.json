{
  "$schema": "../../../crates/tauri-cli/config.schema.json",
  "productName": "Vitul Demo",
  "version": "0.1.4",
  "identifier": "com.litevar.agentos.vitul.demo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vitul Demo",
        "width": 800,
        "height": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/vitul-demo/icon.png",
      "icons/vitul-demo/32x32.png",
      "icons/vitul-demo/128x128.png",
      "icons/vitul-demo/128x128@2x.png",
      "icons/vitul-demo/icon.icns",
      "icons/vitul-demo/icon.ico"
    ]
  }
}
